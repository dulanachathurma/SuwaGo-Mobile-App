<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. Background Setup -->
    <ImageView
        android:id="@+id/bgImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/dark_medical_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/dark_medical_bg" />

    <!-- Dark Overlay (50% Black Tint) -->
    <View
        android:id="@+id/darkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Guideline for Bottom Typography Placement -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.74" />

    <!-- 2. Center Branding (Logo & Title) -->
    <!-- Image 1: Responsive 3D Stethoscope Logo -->
    <ImageView
        android:id="@+id/imgStethoscope"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="SuwaGo Stethoscope Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/vitacare_logo"
        app:layout_constraintBottom_toTopOf="@+id/imgSuwagoText"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="160dp"
        app:layout_constraintWidth_percent="0.32"
        tools:src="@drawable/vitacare_logo" />

    <!-- Image 2: Responsive Unified SuwaGo Text Logo Container -->
    <LinearLayout
        android:id="@+id/imgSuwagoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgStethoscope">

        <!-- Container for "suwa" -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- "suw" in electric blue -->
                <TextView
                    android:id="@+id/tvSuw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.04"
                    android:text="suw"
                    android:textColor="#0066FF"
                    android:textSize="80sp"
                    android:textStyle="bold" />

                <!-- "a" in electric blue -->
                <TextView
                    android:id="@+id/tvA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.04"
                    android:text="a"
                    android:textColor="#0066FF"
                    android:textSize="80sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- "g" in vibrant red -->
        <TextView
            android:id="@+id/tvG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.04"
            android:text="g"
            android:textColor="#E50914"
            android:textSize="80sp"
            android:textStyle="bold" />

        <!-- "o" red circular badge with white center and stethoscope icon -->
        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_red_circle">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_white_circle">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vitacare_logo" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 3-Dots Pulsing Loading Animation (Accent Pink #E91E63) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeDotsLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txtSinhalaTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgSuwagoText" />

    <!-- 3. Bottom Typography -->
    <!-- Primary Sinhala Tagline -->
    <TextView
        android:id="@+id/txtSinhalaTagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="නීරෝගී ජීවිතයකට"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="40sp"
        app:autoSizeMinTextSize="18sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_bottom" />

    <!-- Secondary English Tagline -->
    <TextView
        android:id="@+id/txtEnglishTagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="Your Personal Health Companion"
        android:textColor="#E5E7EB"
        android:textSize="15sp"
        app:autoSizeMaxTextSize="20sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSinhalaTagline" />

</androidx.constraintlayout.widget.ConstraintLayout>
