    <string name="ai_intro">அறிகுறிகள், அளவீடுகள், BMI அல்லது எந்த மருத்துவரைச் சந்திக்க வேண்டும் என்று கேளுங்கள்.</string>
    <string name="ai_hello">வணக்கம்! நான் உங்கள் Suwago AI உதவியாளர். இன்று நான் எப்படி உதவலாம்?</string>
    <string name="ai_placeholder">உங்கள் கேள்வியை எழுதுங்கள்...</string>
    <string name="ai_thinking">யோசிக்கிறது...</string>
    <string name="ai_clear">புதிய உரையாடல்</string>
    <string name="ai_disclaimer">AI வழிகாட்டுதல் பொதுவான தகவல் மட்டுமே, நோய் கண்டறிதல் அல்ல. அவசரநிலையில் அருகிலுள்ள மருத்துவமனைக்குச் செல்லுங்கள்.</string>
    <string name="ai_s1">என் BMI என்றால் என்ன?</string>
    <string name="ai_s2">எனக்கு தலைவலி மற்றும் காய்ச்சல் உள்ளது</string>
    <string name="ai_s3">முதுகு வலிக்கு எந்த மருத்துவர்?</string>
    <string name="ai_s4">இரத்த அழுத்தத்தை எப்படிக் குறைப்பது?</string>
    <string name="ai_offline">இணைப்பு இல்லை — செயலியின் அடிப்படை பதில்</string>
    <string name="ai_fallbackDefault">அறிகுறிகள், நோய்கள் மற்றும் மருத்துவர் பரிந்துரைகளில் நான் உதவ முடியும். நீங்கள் உணர்வதை விவரியுங்கள், எ.கா: தலைவலி மற்றும் காய்ச்சல்.</string>
    <string name="ai_fallbackSee">நீங்கள் விவரித்ததன் அடிப்படையில் பொருத்தமான நிபுணர்:</string>
